# Supabase project settings — find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser.
# Used for admin actions like inviting users. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shown in emails / invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Techmo Software Solutions
